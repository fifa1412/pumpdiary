# Supabase — copy this file to `.env.local` and fill in your real values.
# Find both values in your Supabase project: Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# Never put a service_role / sb_secret_ key in this file — this app only needs the publishable key.
# Optional: Google OAuth client ID (Web application) for uploading play videos to the player's own YouTube channel.
# The upload button is hidden while this is empty.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Optional: Claude API key for reading score screenshots on the server (never NEXT_PUBLIC_).
# Without it the form falls back to in-browser OCR.
ANTHROPIC_API_KEY=
